				}
			}

			document.addEventListener('DOMContentLoaded', function() {
				initChart();
				// Halloween: canvas text can't swap fonts after the fact, so redraw once the poster fonts arrive
				if (isHalloween && document.fonts) {
					Promise.all(["500 12px 'Libre Franklin'", "400 17px 'League Gothic'"].map(f => document.fonts.load(f)))
						.then(() => { if (calorieChart) calorieChart.update('none'); })
