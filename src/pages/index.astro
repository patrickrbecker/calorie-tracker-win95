						const t = (el.querySelector('legend') || {}).textContent || '';
						return /Daily Tracking/.test(t) ? 'tracking' : /Standings|Overall/.test(t) ? 'standings'
							: /Cumulative/.test(t) ? 'chart' : /Getting Started/.test(t) ? 'getting-started' : null;
					};
					if ('IntersectionObserver' in window) {
						const io = new IntersectionObserver((entries) => entries.forEach((e) => {
							const needed = Math.min(e.boundingClientRect.height, window.innerHeight) * 0.4;
							if (e.isIntersecting && e.intersectionRect.height >= needed) { const n = sectionName(e.target); if (n) sections.add(n); }
						}), { threshold: [0, 0.1, 0.25, 0.5, 0.75, 1] });
						document.querySelectorAll('fieldset.group-box, .shoutbox-window').forEach((el) => io.observe(el));
					}
					let maxScroll = 0;
					const onScroll = () => {
						const h = document.documentElement.scrollHeight;
						if (h > 0) maxScroll = Math.max(maxScroll, Math.min(100, Math.round((window.scrollY + window.innerHeight) / h * 100)));
					};
					window.addEventListener('scroll', onScroll, { passive: true });
					onScroll();
					let visibleMs = 0, visibleSince = document.hidden ? null : Date.now();
					const send = () => {
						const ms = visibleMs + (visibleSince ? Date.now() - visibleSince : 0);
						const body = JSON.stringify({ pv: visitPv, vid: vid, screen: screen.width + 'x' + screen.height,
							viewport: window.innerWidth + 'x' + window.innerHeight, ms: ms, scroll: maxScroll, sections: Array.from(sections) });
						try { navigator.sendBeacon('/api/visit-beacon', new Blob([body], { type: 'application/json' })); } catch (e) {}
					};
					document.addEventListener('visibilitychange', () => {
						if (document.hidden) { if (visibleSince) { visibleMs += Date.now() - visibleSince; visibleSince = null; } send(); }
						else visibleSince = Date.now();
					});
					window.addEventListener('pagehide', send);
					setTimeout(send, 3000);
				} catch (e) {}
			})();
		</script>
	</body>
</html>