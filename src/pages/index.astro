				<script is:inline>
					// Halloween FX: bats fly L->R, pumpkins rain from the whole top edge
					(function() {
						const fx = document.getElementById('hwFx');
						const rm = matchMedia('(prefers-reduced-motion: reduce)');
						const MAX_BATS = 4, MAX_NODES = 24;
						let pkTimer, batTimer;
						const rand = (a, b) => a + Math.random() * (b - a);

						function make(cls, style, child) {
							const el = document.createElement('span');
							el.className = cls;
							el.style.cssText = style;
							if (typeof child === 'string') el.textContent = child; else el.appendChild(child);
							return el;
						}

						function launch(el) {
							const done = e => { if (e.target === el) el.remove(); };
							el.addEventListener('animationend', done);
							el.addEventListener('animationcancel', done);
							fx.appendChild(el);
						}

						// Depth z: 0 = far (small, slow, faint), 1 = near (big, fast)
						function pumpkin() {
							if (document.hidden) return;
							const z = Math.random();
							if (fx.childElementCount < MAX_NODES) launch(make('hw-pk',
								`left:${rand(0, 100)}%;font-size:${16 + z * 20}px;opacity:${.75 + z * .25};--t:${4 + (1 - z) * 5 + rand(0, 1)}s`,
								make('hw-sway', `--sw:${rand(4, 16)}px;--rot:${rand(8, 24)}deg;--st:${rand(1.2, 2.6)}s`, '🎃')));
							// Visible ~= spawn rate x mean fall (~7s): ~12 on desktop, ~5 on phones
							const target = Math.min(12, Math.max(5, innerWidth / 120));
							pkTimer = setTimeout(pumpkin, rand(.4, 1.6) * 7000 / target);
						}

						function bat() {
							if (document.hidden) return;
							const z = Math.random();
							if (fx.getElementsByClassName('hw-bat').length < MAX_BATS && fx.childElementCount < MAX_NODES) launch(make('hw-bat',
								`top:${rand(5, 75)}%;font-size:${18 + z * 22}px;--t:${5 + (1 - z) * 6 + rand(0, 1)}s;--dy:${rand(-40, 40)}px`,
								make('hw-bob', `--bob:${rand(6, 18)}px;--bt:${rand(.7, 1.3)}s`,
									make('hw-flap', `--ft:${rand(.14, .22)}s`, '🦇'))));
							batTimer = setTimeout(bat, rand(2000, 7000));
						}

						// Fresh timers on every (re)start: nothing spawns while hidden, no backlog burst on return
						function start() {
							clearTimeout(pkTimer);
							clearTimeout(batTimer);
							if (rm.matches) { fx.textContent = ''; return; }
							if (document.hidden) return;
							pkTimer = setTimeout(pumpkin, rand(0, 300));
							batTimer = setTimeout(bat, rand(1000, 3000));
						}

						document.addEventListener('visibilitychange', start);
						rm.onchange = start;
						start();
					})();
				</script>
			</>
		)}
		<script is:inline define:vars={{ visitPv: pvId }}>
