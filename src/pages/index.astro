					.halloween:not(#_) .controls-bar { grid-template-columns: 1fr 1fr 1fr auto; }
					.halloween:not(#_) #selectedDate,
					.halloween:not(#_) #selectedParticipant { grid-column: auto; }
					.halloween:not(#_) .mm-all thead th { top: calc(-1 * var(--mm-pad)); } /* the padded body scrolls here */
				}

				/* ---------- Phones ---------- */
				@media (max-width: 768px) {
					body.halloween:not(#_) {
						height: auto;
						overflow: visible;
						padding: 0;
						background:
							radial-gradient(ellipse at 50% 45%, oklch(10% .02 40 / .1) 30%, oklch(8% .02 40 / .7) 100%),
							url("/bg-halloween.jpg") center top / cover no-repeat scroll var(--mm-ink);
					}
					/* phones: the sheet is full-bleed, so the key art is printed into the poster header itself */
					.halloween:not(#_) .window {
						max-width: 100%;
						background:
							var(--mm-grain-bone),
							linear-gradient(oklch(17% .014 45 / .87), oklch(17% .014 45 / .87)),
							url("/bg-halloween.jpg") 68% 0 / auto 640px no-repeat,
							var(--mm-ink);
					}
					.halloween:not(#_) .title-bar { padding: 22px 20px 0; }
					.halloween:not(#_) .mm-kicker { font-size: .95rem; letter-spacing: .2em; }
					.halloween:not(#_) .mm-burn { font-size: 19cqi; }
					.halloween:not(#_) .mm-month { font-size: calc(236cqi / var(--mm-len, 7)); }
					.halloween:not(#_) .mm-year { margin-top: 6px; font-size: 1.25rem; }
					.halloween:not(#_) .week-nav { padding: 20px 20px 18px; gap: 10px 8px; flex-wrap: nowrap; text-align: left; }
					.halloween:not(#_) .toolbar { margin: 15px 20px 0 0; }
					.halloween:not(#_) .week-label { font-size: 1.55rem; width: auto; order: 0; }
					.halloween:not(#_) .btn { width: auto; font-size: 1.1rem; }
					.halloween:not(#_) .controls-bar {
						grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
						flex-direction: row;
						padding: 0 20px 22px;
					}
					.halloween:not(#_) #selectedDate,
					.halloween:not(#_) #selectedParticipant { grid-column: auto; }
					.halloween:not(#_) .controls-bar .win-input,
					.halloween:not(#_) .controls-bar .win-select,
					.halloween:not(#_) .controls-bar .btn { width: 100%; }
					.halloween:not(#_) .controls-bar .btn-fire { padding: 0 32px 0 18px; font-size: 1.3rem; }
					/* 16px keeps iOS Safari from zooming the page when a field is focused */
					.halloween:not(#_) .win-input,
					.halloween:not(#_) .win-select { font-size: 16px; padding: 0 10px; }
					.halloween:not(#_) .win-select { padding-right: 30px; background-position: right 10px center; }

					.halloween:not(#_) .content { padding: 26px 12px 32px; }
					.halloween:not(#_) .group-box,
					.halloween:not(#_) .shoutbox-window { margin-bottom: 40px; }
					.halloween:not(#_) .shoutbox-window { margin-bottom: 8px; }
					.halloween:not(#_) .group-box legend,
					.halloween:not(#_) .shoutbox-title { font-size: 1.9rem; margin-bottom: 14px; padding-bottom: 10px; }
					/* the heading needs the full width here (a fallback font would wrap it, then jump when the poster font lands),
					   so the Show all control rides the Reel kicker line instead */
					.halloween:not(#_) .mm-daily legend { padding-right: 0; }
					.halloween:not(#_) .mm-toggle { top: calc(.78rem - 30px); height: 30px; }

					.halloween:not(#_) .win-table { font-size: .93rem; }
					.halloween:not(#_) .win-table th { padding: 9px 2px 7px; font-size: 1.1rem; letter-spacing: .04em; }
					.halloween:not(#_) .win-table th:first-child { width: 86px !important; padding-left: 8px; }
					.halloween:not(#_) .win-table td { padding: 9px 2px; font-size: .93rem; }
					.halloween:not(#_) .win-table .date-cell { padding-left: 8px; font-size: .76rem; letter-spacing: 0; text-transform: none; }
					/* no room beside the date on a phone: the tag hangs beneath it */
					.halloween:not(#_) .win-table .mm-today .date-cell::after { display: block; width: max-content; margin: 4px 0 0; padding: 2px 4px 1px; font-size: .8rem; }
					.halloween:not(#_) .editable-cell .edit-input { min-height: 38px; font-size: 16px; padding: 0 2px; }
					.halloween:not(#_) .editable-cell.saving { font-size: .66rem; }
					.halloween:not(#_) .win-table .total-row td { padding: 18px 2px 16px; font-size: .98rem; }
					.halloween:not(#_) .win-table .total-row .date-cell { font-size: 1.1rem; letter-spacing: .04em; }

					.halloween:not(#_) #overallTable th { padding: 0 2px 2px; font-size: .98rem; letter-spacing: .03em; }
					.halloween:not(#_) #overallTable th:first-child { width: 58px !important; }
					.halloween:not(#_) #overallTable th:nth-child(2) { width: 27%; padding-left: 12px; }
					.halloween:not(#_) #overallTable td { padding: 11px 4px; font-size: .95rem; }
					.halloween:not(#_) #overallTable td:nth-child(2) { padding-left: 12px; font-size: 1rem; }
					.halloween:not(#_) #overallTable td:nth-child(3) { font-size: 1.02rem; }
					.halloween:not(#_) #overallTable td:first-child { padding: 0; }
					.halloween:not(#_) #overallTable td:first-child::before { font-size: .56rem; }
					.halloween:not(#_) #overallTable td:first-child::after { font-size: 1.75rem; }
					.halloween:not(#_) #overallTableBody tr:first-child:not(.mm-zero) td { padding-block: 15px; }
					.halloween:not(#_) #overallTableBody tr:first-child:not(.mm-zero) td:nth-child(2) { font-size: 1.55rem; }
					.halloween:not(#_) #overallTableBody tr:first-child:not(.mm-zero) td:first-child::after { font-size: 2.3rem; }

					.halloween:not(#_) .chart-container { padding: 12px 6px 6px; }
					.halloween:not(#_) .shoutbox-messages { padding: 2px 12px; }
					.halloween:not(#_) .shoutbox-form { flex-direction: column; align-items: stretch; }
					.halloween:not(#_) .shoutbox-form .win-select { width: 100% !important; }
					.halloween:not(#_) .shoutbox-form .win-input { flex: none; width: 100%; }
					.halloween:not(#_) .shoutbox-form .btn { width: 100%; }

					.halloween:not(#_) .status-bar { padding: 16px 20px 26px; }
				}

				/* portrait phones: participant select and the ticket take full rows (dense flow pulls Calories up beside the date) */
				@media (max-width: 440px) {
					.halloween:not(#_) .controls-bar { grid-auto-flow: row dense; }
					.halloween:not(#_) .controls-bar #selectedParticipant,
					.halloween:not(#_) .controls-bar .btn-fire { grid-column: 1 / -1; }
				}

				@media (prefers-reduced-motion: reduce) {
					.halloween:not(#_) .week-label::before,
					.halloween:not(#_) .week-label::after { animation: none; }
					.halloween:not(#_) .week-label::after { opacity: .22; }
					.halloween:not(#_) *, .halloween:not(#_) *::before, .halloween:not(#_) *::after { transition-duration: 0s !important; }
				}

				/* === HALLOWEEN FX (bats + pumpkins, spawned by JS) === */
				.hw-fx {
					position: fixed;
					inset: 0;
					z-index: 100;
					overflow: hidden;
					pointer-events: none;
					user-select: none;
					-webkit-user-select: none;
				}
				.hw-pk, .hw-bat {
					position: absolute;
					top: 0; left: 0;
					line-height: 1;
					font-family: 'Apple Color Emoji', 'Segoe UI Emoji', 'Noto Color Emoji', sans-serif;
					will-change: transform;
				}
				.hw-fx span span { display: block; }
				.hw-pk { animation: hw-fall var(--t) linear forwards; }
				.hw-sway { animation: hw-sway var(--st) ease-in-out infinite alternate; }
				.hw-bat { z-index: 1; animation: hw-fly var(--t) linear forwards; }
				.hw-bob { animation: hw-bob var(--bt) ease-in-out infinite alternate; }
				.hw-flap { animation: hw-flap var(--ft) ease-in-out infinite alternate; }
				@keyframes hw-fall {
					from { transform: translate(-50%, -120%); }
					to { transform: translate(-50%, calc(100vh + 20%)); }
				}
				@keyframes hw-sway {
					from { transform: translateX(calc(var(--sw) * -1)) rotate(calc(var(--rot) * -1)); }
					to { transform: translateX(var(--sw)) rotate(var(--rot)); }
				}
				@keyframes hw-fly {
					from { transform: translate(-120%, 0); }
					to { transform: translate(calc(100vw + 20%), var(--dy)); }
				}
				@keyframes hw-bob {
					from { transform: translateY(calc(var(--bob) * -1)) rotate(-8deg); }
					to { transform: translateY(var(--bob)) rotate(4deg); }
				}
				/* Apple's bat glyph faces left; mirror it so it faces its L->R flight */
				@keyframes hw-flap {
					from { transform: scaleX(-1); }
					to { transform: scaleX(-1) scaleY(.6); }
				}
				@media (prefers-reduced-motion: reduce) {
					.hw-fx { display: none; }
				}
			</style>
		)}
	</head>
	<body class={isHalloween ? 'halloween' : undefined}>
		<div class="window">
			<!-- Title Bar -->
			<div class="title-bar">
				{isHalloween ? (
					<h1 class="mm-title" style={`--mm-len:${contestMonth.length}`}>
						<span class="mm-kicker">Calorie Tracker Pictures presents</span>
						<span class="mm-burn">Burning</span>
						<span class="mm-month">{contestMonth}</span>
						<span class="mm-year">{contestLabel.split(' ')[1]}</span>
					</h1>
				) : (
					<span>Burning {contestLabel} - Calorie Tracker</span>
				)}
				<div class="title-controls">
					<button>_</button>
					<button>&#9633;</button>
					<button>X</button>
				</div>
			</div>

			<!-- Toolbar -->
			<div class="toolbar">
				<button class="btn active-tab" onclick="window.location.href='/'">Tracker</button>
			</div>

			<!-- Week Navigation -->
			<div class="week-nav">
				<button class="btn" id="prevWeek">&lt; Prev Week <img src="/icons/calendar.png" alt="" class="btn-icon"></button>
				<span class="week-label">{contestLabel} - Week {currentWeekNumber}</span>
				<button class="btn" id="nextWeek"><img src="/icons/calendar.png" alt="" class="btn-icon"> Next Week &gt;</button>
			</div>

			<!-- Controls -->
			<div class="controls-bar">
				<input type="date" class="win-input" id="selectedDate" value={defaultDate}>
				<select class="win-select" id="selectedParticipant">
					<option value="">Select participant</option>
					{participants.map(participant => (
						<option value={participant}>{participant}</option>
					))}
				</select>
				<input type="number" class="win-input" id="calorieAmount" placeholder="Calories" min="0" style="width:100px;">
				<button type="button" class="btn btn-fire" id="addCaloriesBtn">Add Calories <img src="/icons/calc.png" alt="" class="btn-icon"></button>
			</div>

			<!-- Main Content -->
			<div class="content-wrapper">
			<div class="content" id="scrollContent">
				<!-- Weekly Table -->
				<fieldset class:list={['group-box', isHalloween && 'mm-daily', showAll && 'mm-all']}>
					<legend>{isHalloween ? <><span class="mm-when-week">Week {currentWeekNumber}</span><span class="mm-when-all">{contestMonth}</span></> : <>Week {currentWeekNumber}</>} - Daily Tracking</legend>{isHalloween && (
						<button type="button" class="btn mm-toggle" id="mmShowAll" aria-controls="mmDaily" aria-expanded={String(showAll)}>{showAll ? 'Show week' : 'Show all'}</button>
					)}
					<div class="group-box-content">
						<div class="table-scroll">
							<table class="win-table" id={isHalloween ? 'mmDaily' : undefined}>
								<thead>
									<tr>
										<th style="width:130px;">Date</th>
										{participants.map(participant => (
											<th>{participant}</th>
										))}
									</tr>
								</thead>
								<tbody>
									{tableDays.map(day => (
										<>{day.weekStart && (
											<tr class="mm-wk"><th colspan={participants.length + 1}>Week {day.week}</th></tr>
										)}<tr class={day.cls}>
											<td class="date-cell">{day.displayDate}</td>
											{participants.map(participant => (
												<td class="editable-cell"
													data-participant={participant}
													data-date={day.date}
													data-week={day.week || currentWeekNumber}
													title="Click to edit">
													<span class="calorie-value">{(isHalloween ? allWeeksData : weekData)[day.date]?.[participant] || ''}</span>
												</td>
											))}
										</tr></>
									))}
									<!-- Weekly Total Row -->
									<tr class="total-row">
										<td class="date-cell">WEEKLY TOTAL</td>
										{participants.map(participant => (
											<td class={isHalloween && weekTop > 0 && weeklyTotals[participant] === weekTop ? 'mm-top' : undefined}>{weeklyTotals[participant] || 0}</td>
										))}
									</tr>{isHalloween && (
										<tr class="total-row mm-month-total">
											<td class="date-cell">MONTHLY TOTAL</td>
											{participants.map(participant => (
												<td class={monthTop > 0 && monthTotals[participant] === monthTop ? 'mm-top' : undefined}>{monthTotals[participant]}</td>
											))}
										</tr>
									)}
								</tbody>
							</table>
						</div>
					</div>
				</fieldset>

				{participants.length === 0 && (
					<fieldset class="group-box">
						<legend>Getting Started</legend>
						<div class="group-box-content" style="text-align: center; padding: 20px;">
							<p><strong>No participants yet!</strong></p>
							<p>Add your first participant above to start the contest.</p>
						</div>
					</fieldset>
				)}

				<!-- Overall Leaderboard -->
				{participants.length > 0 && (
					<fieldset class="group-box">
						<legend>{isHalloween ? `${contestMonth} Standings` : 'Overall Calories Burned'}</legend>
						<div class="group-box-content">
							<div class="table-scroll">
								<table class="win-table" id="overallTable">
									<thead>
										<tr>
											<th>Rank</th>
											<th>Participant</th>
											<th><span class="hide-mobile">Total </span>Cals</th>
											<th><span class="hide-mobile">Pizza Slices </span>🍕 Burned</th>
											<th>{isHalloween ? <><span class="hide-mobile">Pumpkins </span>🔪 Carved</> : <><span class="hide-mobile">Torta's </span>🍑 Pounded</>}</th>
										</tr>
									</thead>
									<tbody id="overallTableBody">
										{(isHalloween ? monthStandings : participantTotals)
											.sort((a, b) => b.total_calories - a.total_calories)
											.map((participant, index) => {
												const rank = index + 1;
												// Halloween: no ticket number (or medal) until you've burned something this month
												const unranked = isHalloween && participant.total_calories === 0;
												let rankClass = '';
												let rankText = `#${rank}`;

												if (unranked) { rankText = 'Unranked'; }
												else if (rank === 1) { rankClass = 'rank-gold'; rankText = '🥇 #1'; }
												else if (rank === 2) { rankClass = 'rank-silver'; rankText = '🥈 #2'; }
												else if (rank === 3) { rankClass = 'rank-bronze'; rankText = '🥉 #3'; }

												const pizzaSlices = Math.floor(participant.total_calories / 300);
												const tortasPounded = Math.floor(participant.total_calories / 100);
												const pumpkinsCarved = Math.floor(participant.total_calories / 150);

												return (
													<tr class={unranked ? 'mm-zero' : undefined}>
														<td class={rankClass} style="text-align:center; font-weight:700;">{rankText}</td>
														<td style="text-align:left; font-weight:700;">{participant.name}</td>
														<td>{participant.total_calories.toLocaleString()}</td>
														<td>{pizzaSlices.toLocaleString()}</td>
														<td>{(isHalloween ? pumpkinsCarved : tortasPounded).toLocaleString()}</td>
													</tr>
												);
											})}
									</tbody>
								</table>
							</div>
						</div>
					</fieldset>
				)}

				<!-- Chart -->
				{participants.length > 0 && (
					<fieldset class="group-box">
						<legend>Cumulative Calorie Progress - {contestLabel}</legend>
						<div class="group-box-content">
							<div class="chart-container">
								<canvas id="calorieChart" width="400" height="200"></canvas>
							</div>
						</div>
					</fieldset>
				)}

				<!-- Shoutbox -->
				<div class="shoutbox-window">
					<div class="shoutbox-title">Team Chat</div>
					<div class="shoutbox-messages" id="shoutboxMessages">
						<div style="text-align: center; color: var(--gray); padding: 10px;">
							Loading messages...
						</div>
					</div>
					<div class="shoutbox-form">
						<select class="win-select" id="shoutUsername" style="width:120px; flex:none;">
							<option value="">Name</option>
							{participants.map(p => (
								<option value={p}>{p}</option>
							))}
						</select>
						<input type="text" class="win-input" id="shoutMessage" placeholder="Type a message..." maxlength="500">
						<button type="button" class="btn" id="sendShoutBtn">Send</button>
					</div>
				</div>
			</div>

			<!-- Custom Win95 Scrollbar -->
			<div class="win95-scrollbar" id="customScrollbar">
				<div class="scrollbar-btn scrollbar-up" id="scrollUp">
					<svg height="26" width="26" viewBox="0 0 26 26"><g transform="rotate(180 13 13)"><polygon fill="#0a0a0a" points="6,10 20,10 13,17"></polygon></g></svg>
				</div>
				<div class="scrollbar-track" id="scrollTrack">
					<div class="scrollbar-thumb" id="scrollThumb"></div>
				</div>
				<div class="scrollbar-btn scrollbar-down" id="scrollDown">
					<svg height="26" width="26" viewBox="0 0 26 26"><polygon fill="#0a0a0a" points="6,10 20,10 13,17"></polygon></svg>
				</div>
			</div>
			</div>

			<!-- Status Bar -->
			<div class="status-bar">
				<div class="status-field"><img src="/icons/info.png" alt="" class="btn-icon"> Burning {contestLabel} - Active Calorie Contest | <a href="/admin" class="copyright-link">&copy; Pat Becker</a></div>
				<div class="status-field">Week {currentWeekNumber} of 5</div>
				<div class="status-field">{participants.length} participants</div>
			</div>

			<div class="resize-handle"></div>
		</div>

		<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
		<script define:vars={{ currentWeek: currentWeekNumber, chartData: participantTotals, weekData: weekData, participants: participants, weekDays: weekDays, allWeeksData: allWeeksData, daysInMonth: daysInCurrentMonth, protectedUser: protectedUser, isHalloween: isHalloween }}>
			// currentWeek is now available from define:vars

			// Initialize chart if we have data
			let calorieChart = null;

			function initChart() {
				const canvas = document.getElementById('calorieChart');
				if (!canvas || !participants || participants.length === 0) return;

				const ctx = canvas.getContext('2d');

				// Destroy existing chart if it exists
				if (calorieChart) {
					calorieChart.destroy();
				}

				// Generate dates for entire current month
				const today = new Date();
				const chartYear = today.getFullYear();
				const chartMonth = today.getMonth();
				const maxDay = daysInMonth;

				const allDates = [];
				for (let day = 1; day <= maxDay; day++) {
					const mm = String(chartMonth + 1).padStart(2, '0');
					const dd = String(day).padStart(2, '0');
					const dateStr = `${chartYear}-${mm}-${dd}`;
					const date = new Date(chartYear, chartMonth, day);
					allDates.push({
						date: dateStr,
						displayDate: date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })
					});
				}

				// Halloween ("Pumpkin Patch"): pumpkin, cobalt, wine, lavender, teal, olive -- all >= 3:1 on the bone
				// chart paper and distinct pairwise for normal and red-green CVD vision; lines 4-6 are also dashed
				const colors = isHalloween
					? ['#d56405', '#2e3cca', '#921c62', '#9478c4', '#139676', '#3f610b']
					: ['#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF', '#FF9F40'];

				if (isHalloween) {
					Chart.defaults.font.family = "'Libre Franklin', 'Franklin Gothic Medium', 'Helvetica Neue', sans-serif";
					Chart.defaults.font.weight = 500;
					Chart.defaults.color = '#4d3f35';
					Chart.defaults.borderColor = 'rgba(28, 21, 18, 0.11)';
					Chart.defaults.plugins.legend.labels.color = '#231b16';
					Chart.defaults.plugins.legend.labels.boxHeight = 3;
					Object.assign(Chart.defaults.plugins.tooltip, {
						backgroundColor: '#1c1512', titleColor: '#f6ecd9', bodyColor: '#f6ecd9', cornerRadius: 0, padding: 10,
						titleFont: { family: "'League Gothic', sans-serif", size: 17, weight: 400 }, displayColors: true, boxPadding: 4
					});
				}

				const todayStr = `${chartYear}-${String(chartMonth + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;

				// Add a "Start" baseline point so lines visually begin at 0
				const chartDates = [{ date: 'start', displayDate: 'Start' }, ...allDates];
				const labelsWithStart = chartDates.map(d => d.displayDate);

				const datasets = participants.map((participant, index) => {
					let cumulativeTotal = 0;
					const data = chartDates.map(dateObj => {
						// "Start" baseline — everyone begins at 0
						if (dateObj.date === 'start') return 0;
						// Only plot up to today — future dates show null (no line drawn)
						if (dateObj.date > todayStr) return null;
						const dailyCalories = allWeeksData[dateObj.date]?.[participant] || 0;
						cumulativeTotal += dailyCalories;
						return cumulativeTotal;
					});

					const color = colors[index % colors.length];

					return {
						label: participant,
						data: data,
						borderColor: color,
						backgroundColor: color + '1A',
						borderWidth: 3,
						fill: false,
						tension: 0.4,
						pointBackgroundColor: color,
						pointBorderColor: color,
						pointBorderWidth: 2,
						pointRadius: 3,
						spanGaps: false
					};
				});

				if (isHalloween) {
					const dashes = [[], [], [], [10, 5], [2, 4], [14, 4, 2, 4]];
					datasets.forEach((ds, i) => { ds.borderDash = dashes[i % dashes.length]; });
				}

				const isMobile = window.innerWidth <= 768;

				calorieChart = new Chart(ctx, {
					type: 'line',
					data: { labels: labelsWithStart, datasets: datasets.map(ds => ({
