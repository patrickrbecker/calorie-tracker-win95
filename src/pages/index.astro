---
// Fetch existing contest data
import { getParticipants, getWeekData, getParticipantTotals, getCurrentWeek, setCurrentWeek, getAllWeeksData, logVisit } from '../lib/db.js';
import Analytics from '@vercel/analytics/astro';

// Visit telemetry for /stats: runs alongside the page's own queries and never blocks or breaks the page
const reqHeaders = Astro.request.headers;
const decodeHeader = (name) => {
  const v = reqHeaders.get(name);
  if (!v) return null;
  try { return decodeURIComponent(v); } catch { return v; }
};
const pvId = crypto.randomUUID();
const visitLogged = logVisit({
  pvId,
  ip: reqHeaders.get('x-forwarded-for')?.split(',')[0]?.trim() || 'unknown',
  userAgent: reqHeaders.get('user-agent')?.slice(0, 500) || null,
  path: (() => { const u = new URL(Astro.request.url); return (u.pathname + u.search).slice(0, 300); })(),
  city: decodeHeader('x-vercel-ip-city'),
  region: decodeHeader('x-vercel-ip-country-region'),
  country: decodeHeader('x-vercel-ip-country'),
  referrer: reqHeaders.get('referer')?.slice(0, 300) || null,
  language: reqHeaders.get('accept-language')?.split(',')[0]?.trim().slice(0, 64) || null,
  timezone: decodeHeader('x-vercel-ip-timezone')?.slice(0, 64) || null,
  postal: decodeHeader('x-vercel-ip-postal-code')?.slice(0, 16) || null,
  latitude: decodeHeader('x-vercel-ip-latitude')?.slice(0, 16) || null,
  longitude: decodeHeader('x-vercel-ip-longitude')?.slice(0, 16) || null
}).catch(err => console.error('Visit log failed:', err.message));

let participants = [];
let weekData = {};
let participantTotals = [];
let currentWeekNumber = 1;
let allWeeksData = {};

// Check URL params for manual week/date navigation
const url = new URL(Astro.request.url);
const weekParam = url.searchParams.get('week');
const dateParam = url.searchParams.get('date');

try {
  participants = await getParticipants();
  participantTotals = await getParticipantTotals();
  allWeeksData = await getAllWeeksData();

  currentWeekNumber = weekParam ? Math.min(Math.max(parseInt(weekParam) || 1, 1), getSundayWeeks().length) : getCurrentWeekByDate();

  // Get date range for this week to query by dates (not week_number)
  const weekDatesForQuery = getWeekDates(currentWeekNumber);
  const dateRange = weekDatesForQuery.length > 0 ? {
    start: weekDatesForQuery[0],
    end: weekDatesForQuery[weekDatesForQuery.length - 1]
  } : null;
  weekData = await getWeekData(currentWeekNumber, dateRange);
} catch (error) {
  console.log('No existing data found, starting fresh');
  currentWeekNumber = weekParam ? Math.min(Math.max(parseInt(weekParam) || 1, 1), getSundayWeeks().length) : getCurrentWeekByDate();
}

// Let the visit insert finish before the function returns, but never hold the page more than 1.5s for it
await Promise.race([visitLogged, new Promise(resolve => setTimeout(resolve, 1500))]);

// Function to get current date in Eastern Time as YYYY-MM-DD string
function getCurrentDateInEasternTime() {
  const now = new Date();
  const parts = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/New_York', year: 'numeric', month: '2-digit', day: '2-digit' }).format(now);
  return parts;
}

// Weeks start on Sunday. Compute Sunday-based week boundaries for the current month.
function getSundayWeeks() {
  const now = new Date(getCurrentDateInEasternTime());
  const year = now.getFullYear();
  const month = now.getMonth();
  const daysInMonth = new Date(year, month + 1, 0).getDate();
  const firstDayOfWeek = new Date(year, month, 1).getDay(); // 0=Sun

  const weeks = [];
  let weekStart = 1;

  // Week 1: day 1 through the first Saturday (or end of month)
  let firstSatDay = (7 - firstDayOfWeek) % 7; // days until first Saturday
  if (firstSatDay === 0 && firstDayOfWeek !== 0) firstSatDay = 7;
  if (firstSatDay === 0) firstSatDay = 7; // if month starts on Sunday, first week is 7 days
  let weekEnd = Math.min(firstSatDay || 7, daysInMonth);
  weeks.push({ start: weekStart, end: weekEnd });

  // Remaining weeks: Sunday to Saturday
  weekStart = weekEnd + 1;
  while (weekStart <= daysInMonth) {
    weekEnd = Math.min(weekStart + 6, daysInMonth);
    weeks.push({ start: weekStart, end: weekEnd });
    weekStart = weekEnd + 1;
  }

  return weeks;
}

function getCurrentWeekByDate() {
  const now = new Date(getCurrentDateInEasternTime());
  const day = now.getDate();
  const weeks = getSundayWeeks();
  for (let i = 0; i < weeks.length; i++) {
    if (day >= weeks[i].start && day <= weeks[i].end) {
      return i + 1;
    }
  }
  return weeks.length;
}

// Generate dates for a given week number in the current month (Sunday-based)
function getWeekDates(weekNumber) {
  const now = new Date(getCurrentDateInEasternTime());
  const year = now.getFullYear();
  const month = now.getMonth();
  const weeks = getSundayWeeks();
  const week = weeks[Math.min(weekNumber - 1, weeks.length - 1)];
  const dates = [];
  for (let d = week.start; d <= week.end; d++) {
    const mm = String(month + 1).padStart(2, '0');
    const dd = String(d).padStart(2, '0');
    dates.push(`${year}-${mm}-${dd}`);
  }
  return dates;
}

// Generate days for current week using exact dates
const weekDays = [];
const weekDateStrings = getWeekDates(currentWeekNumber);

weekDateStrings.forEach(dateString => {
  const [y, m, d] = dateString.split('-').map(Number);
  const date = new Date(y, m - 1, d);
  const dayInfo = {
    date: dateString,
    displayDate: date.toLocaleDateString('en-US', {
      weekday: 'short',
      month: 'short',
      day: 'numeric'
    })
  };
  weekDays.push(dayInfo);
});

// Dynamic month label
const now = new Date(getCurrentDateInEasternTime());
const contestLabel = now.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
const daysInCurrentMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();

// Set date picker to today if within displayed week, otherwise first day of displayed week
const todayStr = getCurrentDateInEasternTime();
const defaultDate = dateParam || (weekDateStrings.includes(todayStr) ? todayStr : weekDateStrings[0]);
const protectedUser = import.meta.env.PROTECTED_USER || '';

// Halloween theme: 2026-09-28 through 2026-10-31 (Eastern), off from Nov 1. Preview with ?theme=halloween / ?theme=off
const themeParam = url.searchParams.get('theme');
const isHalloween = themeParam === 'halloween' || (themeParam !== 'off' && todayStr >= '2026-09-28' && todayStr <= '2026-10-31');
const contestMonth = contestLabel.split(' ')[0];

// Calculate weekly totals for each participant
const weeklyTotals = {};
participants.forEach(participant => {
  weeklyTotals[participant] = 0;
  weekDays.forEach(day => {
    const dayData = weekData[day.date];
    if (dayData && dayData[participant]) {
      weeklyTotals[participant] += dayData[participant];
    }
  });
});
// Halloween lights the week's top total(s) on the marquee strip; an all-zero week has no leader
const weekTop = Math.max(0, ...Object.values(weeklyTotals));

// Halloween standings count only the displayed month: every participant (zeros too), pre-sorted A-Z so the
// leaderboard's stable sort by total keeps ties alphabetical. The same totals light the "Show all" month strip.
const monthTotals = Object.fromEntries(participants.map(p => [p, 0]));
Object.entries(allWeeksData).forEach(([date, day]) => {
  if (date.startsWith(todayStr.slice(0, 7))) participants.forEach(p => { monthTotals[p] += Number(day[p]) || 0; });
});
const monthTop = Math.max(0, ...Object.values(monthTotals));
const monthStandings = participants.map(name => ({ name, total_calories: monthTotals[name] })).sort((a, b) => a.name.localeCompare(b.name));

// Halloween "Show all" (?view=all, so a save's reload comes back expanded): the table holds every day of the month,
// each row posting its own Sunday-based week; rows outside the displayed week stay hidden until expanded
const showAll = isHalloween && url.searchParams.get('view') === 'all';
const tableDays = !isHalloween ? weekDays : getSundayWeeks().flatMap((_, w) => getWeekDates(w + 1).map((date, i) => {
  const [y, m, d] = date.split('-').map(Number);
  return {
    date,
    displayDate: new Date(y, m - 1, d).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }),
    week: w + 1,
    weekStart: i === 0,
    cls: [date === todayStr && 'mm-today', w + 1 !== currentWeekNumber && 'mm-off'].filter(Boolean).join(' ') || undefined
  };
}));
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={isHalloween ? '/favicon-halloween.svg' : '/favicon.svg'} />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<title>{`${isHalloween ? '🎃 ' : ''}Burning ${contestLabel}`}</title>

		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-4C0YRJ9CXX"></script>
		<script>
		  window.dataLayer = window.dataLayer || [];
		  function gtag(){dataLayer.push(arguments);}
		  gtag('js', new Date());
		  gtag('config', 'G-4C0YRJ9CXX');
		</script>

		<Analytics />
		{isHalloween && (
			<>
				<link rel="preconnect" href="https://fonts.googleapis.com" />
				<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
				<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Creepster&family=League+Gothic&family=Libre+Franklin:wght@400..800&display=swap" />
			</>
		)}
		<style>
			/* === WIN95 FONT === */
			@font-face {
				font-family: 'W95';
				src: url('https://unpkg.com/react95@4.0.0/dist/fonts/ms_sans_serif.woff2') format('woff2');
				font-weight: 400;
			}
			@font-face {
				font-family: 'W95';
				src: url('https://unpkg.com/react95@4.0.0/dist/fonts/ms_sans_serif_bold.woff2') format('woff2');
				font-weight: 700;
			}

			/* === RESET === */
			* { margin: 0; padding: 0; box-sizing: border-box; }

			:root {
				--bg: #c6c6c6;
				--dark: #0a0a0a;
				--white: #fefefe;
				--gray: #848584;
				--light: #dfdfdf;
				--title-bg: #060084;
				--teal: #008080;
				--page-bg: #0a0a3a;
			}

			html { font-size: 14px; }

			html, body { height: 100%; overflow: hidden; margin: 0; }

			body {
				font-family: 'W95', 'Segoe UI', Tahoma, sans-serif;
				background: url("/bg.jpg") center center / cover no-repeat fixed #008080;
				color: var(--dark);
				display: flex;
				justify-content: center;
				align-items: center;
				padding: 16px 20px;
				line-height: 1.4;
			}

			/* === RAISED BORDER (outset) === */
			.raised {
				border: 2px solid;
				border-color: var(--white) var(--dark) var(--dark) var(--white);
				box-shadow: 1px 1px 0 0 var(--light) inset, -1px -1px 0 0 var(--gray) inset;
			}

			/* === SUNKEN BORDER (inset) === */
			.sunken {
				border: 2px solid;
				border-color: var(--gray) var(--white) var(--white) var(--gray);
				box-shadow: var(--dark) 1px 1px 0 0 inset, var(--light) -1px -1px 0 0 inset;
			}

			/* === WINDOW === */
			.window {
				background: var(--bg);
				border: 2px solid;
				border-color: var(--light) var(--dark) var(--dark) var(--light);
				box-shadow:
					1px 1px 0 1px var(--white) inset,
					-1px -1px 0 1px var(--gray) inset,
					rgba(0,0,0,0.35) 4px 4px 10px 0px;
				width: 100%;
				max-width: 1000px;
				display: flex;
				flex-direction: column;
				position: relative;
				max-height: calc(100vh - 32px);
				min-height: 0;
			}

			/* === TITLE BAR === */
			.title-bar {
				background: var(--title-bg);
				color: var(--white);
				font-weight: 700;
				padding: 3px 4px;
				display: flex;
				align-items: center;
				justify-content: space-between;
				user-select: none;
			}
			.title-bar span { padding-left: 2px; font-size: 1rem; }
			.title-controls { display: flex; gap: 2px; }
			.title-controls button {
				width: 18px; height: 18px;
				background: var(--bg);
				border: 2px solid;
				border-color: var(--white) var(--dark) var(--dark) var(--white);
				box-shadow: 1px 1px 0 0 var(--light) inset, -1px -1px 0 0 var(--gray) inset;
				font-family: 'W95', sans-serif;
				font-size: 10px; font-weight: 700;
				cursor: pointer;
				display: flex; align-items: center; justify-content: center;
				padding: 0;
			}
			.title-controls button:active {
				border-color: var(--dark) var(--white) var(--white) var(--dark);
				box-shadow: 1px 1px 0 0 var(--gray) inset;
			}

			/* === TOOLBAR === */
			.toolbar {
				display: flex;
				align-items: center;
				padding: 4px;
				gap: 4px;
				flex-wrap: wrap;
			}

			/* === BUTTONS === */
			.btn {
				font-family: 'W95', sans-serif;
				font-size: 1rem;
				background: var(--bg);
				color: var(--dark);
				border: 2px solid;
				border-color: var(--white) var(--dark) var(--dark) var(--white);
				box-shadow: 1px 1px 0 0 var(--light) inset, -1px -1px 0 0 var(--gray) inset;
				padding: 3px 12px;
				height: 28px;
				cursor: pointer;
				display: inline-flex;
				align-items: center;
				gap: 4px;
				user-select: none;
				white-space: nowrap;
			}
			.btn:active {
				border-color: var(--dark) var(--white) var(--white) var(--dark);
				box-shadow: 1px 1px 0 0 var(--gray) inset;
				padding-top: 5px;
			}
			.btn:disabled {
				color: var(--gray);
				text-shadow: 1px 1px 0 var(--white);
				cursor: default;
			}
			.btn:disabled:active {
				border-color: var(--white) var(--dark) var(--dark) var(--white);
				box-shadow: 1px 1px 0 0 var(--light) inset, -1px -1px 0 0 var(--gray) inset;
				padding-top: 3px;
			}
			.btn.active-tab {
				background: linear-gradient(45deg, var(--bg) 25%, transparent 25%, transparent 75%, var(--bg) 75%) 0 0 / 4px 4px,
							linear-gradient(45deg, var(--bg) 25%, transparent 25%, transparent 75%, var(--bg) 75%) 2px 2px / 4px 4px var(--white);
				border-color: var(--dark) var(--white) var(--white) var(--dark);
				box-shadow: 1px 1px 0 0 var(--gray) inset;
			}
			.btn-fire {
				background: #c6c6c6;
				font-weight: 700;
			}
			.btn-add {
				background: var(--bg);
			}

			/* === CONTENT AREA === */
			.content-wrapper {
				flex: 1;
				min-height: 0;
				display: flex;
				overflow: hidden;
			}

			.content {
				padding: 8px;
				overflow-y: auto;
				overflow-x: hidden;
				flex: 1;
				min-height: 0;
				scrollbar-width: none;
			}
			.content::-webkit-scrollbar { display: none; }

			/* Win95 Custom Scrollbar */
			.win95-scrollbar {
				display: flex;
				flex-direction: column;
				width: 26px;
				flex-shrink: 0;
			}
			.scrollbar-btn {
				background: var(--bg);
				border: 2px solid;
				border-color: var(--light) var(--dark) var(--dark) var(--light);
				box-shadow: 1px 1px 0 0 var(--white) inset, -1px -1px 0 0 var(--gray) inset;
				display: flex;
				align-items: center;
				justify-content: center;
				width: 26px;
				height: 26px;
				flex-shrink: 0;
				cursor: default;
				user-select: none;
			}
			.scrollbar-btn:active {
				border-color: var(--dark) var(--light) var(--light) var(--dark);
				box-shadow: 1px 1px 0 0 var(--gray) inset;
			}
			.scrollbar-track {
				flex: 1;
				position: relative;
				background-image: url("data:image/svg+xml,%3Csvg width='4' height='4' xmlns='http://www.w3.org/2000/svg'%3E%3Crect width='2' height='2' fill='%23c6c6c6'/%3E%3Crect x='2' y='2' width='2' height='2' fill='%23c6c6c6'/%3E%3Crect x='2' width='2' height='2' fill='%23fefefe'/%3E%3Crect y='2' width='2' height='2' fill='%23fefefe'/%3E%3C/svg%3E");
				background-size: 4px 4px;
			}
			.scrollbar-thumb {
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				height: 30px;
				background: var(--bg);
				border: 2px solid;
				border-color: var(--light) var(--dark) var(--dark) var(--light);
				box-shadow: 1px 1px 0 0 var(--white) inset, -1px -1px 0 0 var(--gray) inset;
				cursor: default;
				touch-action: none;
			}

			/* === GROUP BOX (fieldset) === */
			.group-box {
				position: relative;
				border: 2px solid var(--white);
				padding: 12px;
				margin-bottom: 8px;
				box-shadow: var(--gray) -1px -1px 0 1px, var(--gray) -1px -1px 0 1px inset;
			}
			.group-box legend {
				position: absolute;
				top: 0; left: 8px;
				transform: translateY(calc(-50% - 2px));
				padding: 0 8px;
				background: var(--bg);
				font-weight: 700;
			}
			.group-box-content {
				margin-top: 6px;
			}

			/* === INPUTS === */
			.win-input, .win-select {
				font-family: 'W95', sans-serif;
				font-size: 1rem;
				background: #fff;
				color: var(--dark);
				border: 2px solid;
				border-color: var(--gray) var(--white) var(--white) var(--gray);
				box-shadow: var(--dark) 1px 1px 0 0 inset, var(--light) -1px -1px 0 0 inset;
				padding: 3px 6px;
				height: 28px;
			}
			.win-input:focus, .win-select:focus {
				outline: none;
			}
			.win-select {
				cursor: pointer;
			}

			/* === TABLE === */
			.table-scroll { overflow-x: auto; }
			.win-table {
				width: 100%;
				table-layout: fixed;
				border-collapse: collapse;
				font-size: 0.92rem;
				background: #fff;
			}
			.win-table th {
				background: var(--title-bg);
				color: var(--white);
				padding: 4px 8px;
				text-align: center;
				border: 1px solid var(--dark);
				font-weight: 700;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.win-table td {
				padding: 4px 8px;
				text-align: center;
				border: 1px solid var(--gray);
				background: #fff;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.win-table tr:hover td { background: #ffffcc; }
			.win-table .date-cell {
				background: var(--bg);
				font-weight: 700;
				text-align: left;
				padding-left: 10px;
				white-space: nowrap;
				width: 130px;
			}
			.win-table tr:hover .date-cell { background: #e8e8c8; }

			/* Total row */
			.total-row td {
				background: #ffe100 !important;
				font-weight: 700;
				border-top: 2px solid var(--dark);
			}
			.total-row .date-cell {
				background: #d4bf00 !important;
				color: var(--dark);
			}

			/* Rank cells */
			.rank-gold { background: #FFD700 !important; font-weight: 700; }
			.rank-silver { background: #C0C0C0 !important; font-weight: 700; }
			.rank-bronze { background: #CD7F32 !important; font-weight: 700; }

			/* Editable cells */
			.editable-cell { cursor: pointer; }
			.editable-cell:hover {
				background: #d0e8ff !important;
				outline: 2px solid var(--title-bg);
				outline-offset: -2px;
			}
			.editable-cell.editing {
				padding: 0;
				background: #fff3cd !important;
			}
			.editable-cell .edit-input {
				width: 100%;
				padding: 4px;
				border: 2px solid var(--title-bg);
				background: white;
				text-align: center;
				font-family: 'W95', sans-serif;
				font-size: 0.92rem;
				box-sizing: border-box;
			}
			.editable-cell .edit-input:focus { outline: none; }
			.editable-cell.saving { background: #d1ecf1 !important; }
			.editable-cell.error { background: #f8d7da !important; }

			/* === WEEK NAV === */
			.week-nav {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 2px 8px 6px;
				background: var(--bg);
			}
			.week-label { font-weight: 700; font-size: 1.4rem; }

			/* === PARTICIPANT TOGGLE === */
			.participant-toggle {
				width: 100%;
				font-family: 'W95', sans-serif;
				font-size: 1rem;
				background: var(--bg);
				border: none;
				border-top: 1px solid var(--white);
				border-bottom: 1px solid var(--gray);
				padding: 4px 8px;
				text-align: left;
				cursor: pointer;
				display: flex;
				justify-content: space-between;
				align-items: center;
				font-weight: 700;
			}
			.participant-toggle:hover { background: var(--light); }
			.toggle-arrow { transition: transform 0.15s; }
			.participant-toggle.expanded .toggle-arrow { transform: rotate(180deg); }

			.participant-form {
				display: none;
				padding: 8px;
				gap: 8px;
				align-items: center;
				flex-wrap: wrap;
				background: var(--bg);
				border-bottom: 1px solid var(--gray);
			}
			.participant-form.show { display: flex; }

			/* === CONTROLS BAR === */
			.controls-bar {
				padding: 8px;
				display: flex;
				gap: 8px;
				flex-wrap: wrap;
				align-items: center;
				background: var(--bg);
				border-bottom: 1px solid var(--gray);
			}

			/* === SHOUTBOX === */
			.shoutbox-window {
				background: var(--bg);
				border: 2px solid;
				border-color: var(--light) var(--dark) var(--dark) var(--light);
				box-shadow: 1px 1px 0 0 var(--white) inset, -1px -1px 0 0 var(--gray) inset;
				margin-top: 8px;
			}
