---
// Visitor stats (STATS_PASSWORD required): page loads logged by index.astro, names matched from chat IPs,
// network labels from Shodan (looked up once per IP and cached in ip_info)
import { createHash, timingSafeEqual } from 'node:crypto';
import { getVisits, getChatNamesByIp, getIpInfo, saveIpInfo } from '../lib/db.js';

// Auth: STATS_PASSWORD posted from the form (never in the URL); a 30-day HttpOnly cookie holds only its hash
const COOKIE = 'burnware_stats';
const password = process.env.STATS_PASSWORD || '';
const token = password ? createHash('sha256').update('burnware-stats:' + password).digest('hex') : '';
const safeEqual = (a, b) => {
  const x = Buffer.from(String(a)), y = Buffer.from(String(b));
  return x.length === y.length && timingSafeEqual(x, y);
};
let authorized = Boolean(token) && safeEqual(Astro.cookies.get(COOKIE)?.value || '', token);
let failedLogin = false;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData().catch(() => null);
  if (form?.get('action') === 'logout') {
    Astro.cookies.delete(COOKIE, { path: '/stats' });
    authorized = false;
  } else if (token && safeEqual(form?.get('password') || '', password)) {
    Astro.cookies.set(COOKIE, token, { path: '/stats', httpOnly: true, secure: true, sameSite: 'strict', maxAge: 60 * 60 * 24 * 30 });
    return Astro.redirect('/stats', 303);
  } else {
    failedLogin = true;
    await new Promise(r => setTimeout(r, 1000)); // slow down guessing
  }
}
if (!authorized) Astro.response.status = failedLogin ? 401 : 200;
Astro.response.headers.set('Cache-Control', 'no-store');

const TZ = 'America/New_York';
const BOT_RE = /bot|crawl|spider|slurp|preview|facebookexternalhit|curl|wget|python|go-http|httpclient|headless|scan/i;
const etDay = (d) => new Intl.DateTimeFormat('en-CA', { timeZone: TZ, year: 'numeric', month: '2-digit', day: '2-digit' }).format(d);
const etTime = (d) => new Intl.DateTimeFormat('en-US', { timeZone: TZ, month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }).format(d);
const dayLabel = (ymd) => new Date(ymd + 'T12:00:00Z').toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC' });

function device(ua) {
  if (!ua) return 'Unknown';
  const os = /iPhone/.test(ua) ? 'iPhone' : /iPad/.test(ua) ? 'iPad'
    : /Android/.test(ua) ? ((ua.match(/;\s*([^;)]*Pixel[^;)]*)\s*Build/) || [])[1]?.trim() || 'Android')
    : /Macintosh|Mac OS X/.test(ua) ? 'Mac' : /Windows/.test(ua) ? 'Windows' : /Linux/.test(ua) ? 'Linux' : 'Other';
  const browser = /Firefox\//.test(ua) ? 'Firefox' : /Edg\//.test(ua) ? 'Edge' : /CriOS|Chrome\//.test(ua) ? 'Chrome'
    : /Safari\//.test(ua) ? 'Safari' : '';
  return browser ? `${os} · ${browser}` : os;
}

const isLookupable = (ip) => ip && ip !== 'unknown' && !/^(127\.|10\.|192\.168\.|::1$|fe80:|172\.(1[6-9]|2\d|3[01])\.)/.test(ip);

async function shodanLookup(ip, key) {
  const ctrl = new AbortController();
  const timer = setTimeout(() => ctrl.abort(), 3000);
  try {
    const res = await fetch(`https://api.shodan.io/shodan/host/${encodeURIComponent(ip)}?key=${key}&minify=true`, { signal: ctrl.signal });
    if (res.status === 404) return { ip, org: null, isp: null, tags: null, found: false };
    if (!res.ok) return null; // rate limit or outage: try again on a later load
    const d = await res.json();
    return { ip, org: d.org || null, isp: d.isp || null, tags: (d.tags || []).join(', ') || null, found: true };
  } catch {
    return null;
  } finally {
    clearTimeout(timer);
  }
}

let error = '';
let summary = null, people = [], daily = [], recent = [], bots = [], since = null, pending = 0;

if (authorized) {
  try {
    const [visits, chatRows, infoRows] = await Promise.all([getVisits(400), getChatNamesByIp(), getIpInfo()]);
    const chatName = new Map(chatRows.map(r => [r.ip, r.username]));
    const info = new Map(infoRows.map(r => [r.ip, r]));

    // Look up at most 3 new IPs per page load (Shodan allows ~1 request/second)
    const shodanKey = process.env.SHODAN_API_KEY;
    const humans = visits.filter(v => !BOT_RE.test(v.user_agent || ''));
    const missing = [...new Set(humans.map(v => v.ip))].filter(ip => isLookupable(ip) && !info.has(ip));
    if (shodanKey) {
      for (const ip of missing.slice(0, 3)) {
        const r = await shodanLookup(ip, shodanKey);
        if (r) { await saveIpInfo(r).catch(() => {}); info.set(ip, r); }
        await new Promise(res => setTimeout(res, 1100));
      }
    }
    pending = missing.filter(ip => !info.has(ip)).length;

    bots = visits.filter(v => BOT_RE.test(v.user_agent || ''));
    since = visits.length ? new Date(visits[visits.length - 1].created_at) : null;

    const now = new Date();
    const today = etDay(now);
    const weekAgo = Date.now() - 7 * 864e5;
    const uniq = (rows) => new Set(rows.map(v => v.ip)).size;
    summary = {
      todayVisitors: uniq(humans.filter(v => etDay(new Date(v.created_at)) === today)),
      todayLoads: humans.filter(v => etDay(new Date(v.created_at)) === today).length,
      weekVisitors: uniq(humans.filter(v => new Date(v.created_at) >= weekAgo)),
      weekLoads: humans.filter(v => new Date(v.created_at) >= weekAgo).length,
      allVisitors: uniq(humans),
      allLoads: humans.length
    };

    const network = (ip) => { const i = info.get(ip); return i?.found ? (i.org || i.isp || '') : ''; };
    const tags = (ip) => info.get(ip)?.tags || '';
    const place = (v) => [v.city, v.region].filter(Boolean).join(', ') || v.country || '';

    // One row per person (chat-matched name) or per unmatched IP
    const groups = new Map();
    for (const v of humans) {
      const name = chatName.get(v.ip);
      const k = name ? 'n:' + name : 'ip:' + v.ip;
      if (!groups.has(k)) groups.set(k, { name: name || 'Unknown', matched: Boolean(name), ips: new Map(), devices: new Set(), days: new Set(), loads: 0, last: null, first: null });
      const g = groups.get(k);
      const t = new Date(v.created_at);
      if (!g.ips.has(v.ip)) g.ips.set(v.ip, { ip: v.ip, place: place(v), network: network(v.ip), tags: tags(v.ip) });
      g.devices.add(device(v.user_agent));
      g.days.add(etDay(t));
      g.loads++;
      if (!g.last || t > g.last) g.last = t;
      if (!g.first || t < g.first) g.first = t;
    }
    people = [...groups.values()].sort((a, b) => (b.matched - a.matched) || (b.last - a.last));

    const byDay = new Map();
    for (const v of humans) {
      const d = etDay(new Date(v.created_at));
      if (!byDay.has(d)) byDay.set(d, { ips: new Set(), loads: 0 });
      byDay.get(d).ips.add(v.ip); byDay.get(d).loads++;
    }
    daily = [...byDay.entries()].sort((a, b) => b[0].localeCompare(a[0])).slice(0, 14)
      .map(([d, x]) => ({ day: dayLabel(d), visitors: x.ips.size, loads: x.loads }));

    recent = humans.slice(0, 40).map(v => ({
      time: etTime(new Date(v.created_at)), who: chatName.get(v.ip) || 'Unknown', ip: v.ip,
      place: place(v), device: device(v.user_agent), path: v.path
    }));
    bots = bots.slice(0, 20).map(v => ({ time: etTime(new Date(v.created_at)), ip: v.ip, ua: (v.user_agent || '').slice(0, 90) }));
  } catch (e) {
    console.error('Stats error:', e);
    error = 'Could not load visitor data. Check the server logs.';
  }
}
const fmtTime = (d) => d ? etTime(d) : '';
---

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Visitors - Calorie Tracker</title>
    <style>
        @font-face {
            font-family: 'W95';
            src: url('https://unpkg.com/react95@4.0.0/dist/fonts/ms_sans_serif.woff2') format('woff2');
            font-weight: 400;
        }
        @font-face {
            font-family: 'W95';
            src: url('https://unpkg.com/react95@4.0.0/dist/fonts/ms_sans_serif_bold.woff2') format('woff2');
            font-weight: 700;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --bg: #c6c6c6;
            --dark: #0a0a0a;
            --white: #fefefe;
            --gray: #848584;
            --light: #dfdfdf;
            --title-bg: #060084;
            --teal: #008080;
            --red: #a80000;
        }

        html { font-size: 14px; }

        body {
            font-family: 'W95', 'Segoe UI', Tahoma, sans-serif;
            background: url("/bg.jpg") center center / cover no-repeat fixed #008080;
            color: var(--dark);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            padding: 40px 20px;
            line-height: 1.4;
        }

        .window {
            background: var(--bg);
            border: 2px solid;
            border-color: var(--light) var(--dark) var(--dark) var(--light);
            box-shadow:
                1px 1px 0 1px var(--white) inset,
                -1px -1px 0 1px var(--gray) inset,
                rgba(0,0,0,0.35) 4px 4px 10px 0px;
            width: 100%;
            max-width: 1040px;
            position: relative;
        }

        .title-bar {
            background: var(--title-bg);
            color: var(--white);
            font-weight: 700;
            padding: 3px 4px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            user-select: none;
        }
        .title-bar span { padding-left: 2px; }
        .title-controls { display: flex; gap: 2px; }
        .title-controls button {
            width: 18px; height: 18px;
            background: var(--bg);
            border: 2px solid;
            border-color: var(--white) var(--dark) var(--dark) var(--white);
            box-shadow: 1px 1px 0 0 var(--light) inset, -1px -1px 0 0 var(--gray) inset;
            font-family: 'W95', sans-serif;
            font-size: 10px; font-weight: 700;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            padding: 0;
        }
        .title-controls button:active {
            border-color: var(--dark) var(--white) var(--white) var(--dark);
            box-shadow: 1px 1px 0 0 var(--gray) inset;
        }

        .toolbar {
            display: flex;
            align-items: center;
            padding: 4px;
            gap: 4px;
        }

        .btn {
            font-family: 'W95', sans-serif;
            font-size: 1rem;
            background: var(--bg);
            color: var(--dark);
            border: 2px solid;
            border-color: var(--white) var(--dark) var(--dark) var(--white);
            box-shadow: 1px 1px 0 0 var(--light) inset, -1px -1px 0 0 var(--gray) inset;
            padding: 3px 12px;
            height: 28px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            user-select: none;
        }
        .btn:active {
            border-color: var(--dark) var(--white) var(--white) var(--dark);
            box-shadow: 1px 1px 0 0 var(--gray) inset;
            padding-top: 5px;
        }
        .btn:disabled {
            color: var(--gray);
            text-shadow: 1px 1px 0 var(--white);
            cursor: default;
        }
        .btn.active-tab {
            background: linear-gradient(45deg, var(--bg) 25%, transparent 25%, transparent 75%, var(--bg) 75%) 0 0 / 4px 4px,
                        linear-gradient(45deg, var(--bg) 25%, transparent 25%, transparent 75%, var(--bg) 75%) 2px 2px / 4px 4px var(--white);
            border-color: var(--dark) var(--white) var(--white) var(--dark);
            box-shadow: 1px 1px 0 0 var(--gray) inset;
        }
        .btn-danger {
            background: var(--bg);
            font-weight: 700;
        }

        .content { padding: 12px; }

        .group-box {
            position: relative;
            border: 2px solid var(--white);
            padding: 12px;
            margin-bottom: 8px;
            box-shadow: var(--gray) -1px -1px 0 1px, var(--gray) -1px -1px 0 1px inset;
        }
        .group-box legend {
            position: absolute;
            top: 0; left: 8px;
            transform: translateY(calc(-50% - 2px));
            padding: 0 8px;
            background: var(--bg);
            font-weight: 700;
        }
        .group-box-content { margin-top: 6px; }

        .danger-box {
            border-color: #ff0000;
            box-shadow: #a80000 -1px -1px 0 1px, #a80000 -1px -1px 0 1px inset;
        }
        .danger-box legend { color: var(--red); }

        .info-box {
            background: #fff;
            border: 2px solid;
            border-color: var(--gray) var(--white) var(--white) var(--gray);
            box-shadow: var(--dark) 1px 1px 0 0 inset;
            padding: 8px;
            margin-bottom: 8px;
        }

        .status-msg {
            margin-top: 8px;
            padding: 8px;
            display: none;
            font-weight: 700;
        }
        .status-msg.success {
            background: #fff;
            border: 2px solid;
            border-color: var(--gray) var(--white) var(--white) var(--gray);
            color: #008000;
        }
        .status-msg.error {
            background: #fff;
            border: 2px solid;
            border-color: var(--gray) var(--white) var(--white) var(--gray);
            color: var(--red);
        }

        ul {
            list-style: none;
            padding: 0;
            margin: 8px 0;
        }
        ul li::before {
            content: '- ';
        }

        .status-bar {
            display: flex;
            border-top: 2px solid var(--gray);
            box-shadow: 0 -1px 0 0 var(--white);
        }
        .status-field {
            border: 2px solid;
            border-color: var(--gray) var(--white) var(--white) var(--gray);
            padding: 2px 6px;
            font-size: 0.85rem;
            flex: 1;
        }

        .resize-handle {
            position: absolute;
            bottom: 4px; right: 4px;
            width: 18px; height: 18px;
            background-image: linear-gradient(135deg,
                var(--white) 16.67%, var(--bg) 16.67%, var(--bg) 33.33%,
                var(--gray) 33.33%, var(--gray) 50%,
                var(--white) 50%, var(--white) 66.67%, var(--bg) 66.67%, var(--bg) 83.33%,
                var(--gray) 83.33%);
            background-size: 8.49px 8.49px;
            clip-path: polygon(100% 0, 0 100%, 100% 100%);
        }

        p + p { margin-top: 6px; }

        .stat-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
        .stat { background: #fff; border: 2px solid; border-color: var(--gray) var(--white) var(--white) var(--gray); padding: 8px; }
        .stat b { display: block; font-size: 1.6rem; line-height: 1.1; font-variant-numeric: tabular-nums; }
        .stat small { color: var(--gray); }
        .table-wrap { overflow-x: auto; background: #fff; border: 2px solid; border-color: var(--gray) var(--white) var(--white) var(--gray); }
        table { border-collapse: collapse; width: 100%; font-size: 0.9rem; }
        th, td { text-align: left; padding: 4px 8px; border-bottom: 1px solid var(--light); vertical-align: top; white-space: nowrap; }
        th { background: var(--bg); font-weight: 700; position: sticky; top: 0; }
        td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
        td.wrap { white-space: normal; min-width: 200px; }
        .muted { color: var(--gray); }
        .key-form { display: flex; gap: 8px; flex-wrap: wrap; }
        .key-form input { font-family: 'W95', sans-serif; font-size: 1rem; background: #fff; border: 2px solid; border-color: var(--gray) var(--white) var(--white) var(--gray); padding: 3px 6px; height: 28px; flex: 1; min-width: 180px; }
        @media (max-width: 600px) { .stat-row { grid-template-columns: 1fr; } body { padding: 16px; } }
    </style>
</head>
<body>
    <div class="window">
        <div class="title-bar">
            <span>Calorie Tracker - Visitors</span>
            <div class="title-controls"><button>_</button><button>&#9633;</button><button>X</button></div>
        </div>
        <div class="toolbar">
            <button class="btn" onclick="window.location.href='/'">Tracker</button>
            <button class="btn" onclick="window.location.href='/admin'">Admin</button>
            <button class="btn active-tab">Visitors</button>
            {authorized && <form method="post" action="/stats" style="margin-left: auto;"><input type="hidden" name="action" value="logout" /><button class="btn" type="submit">Log out</button></form>}
        </div>
        <div class="content">
            {!authorized ? (
                <fieldset class="group-box">
                    <legend>Password Required</legend>
                    <div class="group-box-content">
                        {failedLogin && <p style="color: var(--red); font-weight: 700;">That password is not correct.</p>}
                        <form class="key-form" method="post" action="/stats">
                            <input type="password" id="password" name="password" placeholder="Password" autocomplete="current-password" required />
                            <button class="btn" type="submit">Open</button>
                        </form>
                    </div>
                </fieldset>
            ) : error ? (
                <div class="info-box" style="color: var(--red); font-weight: 700;">{error}</div>
            ) : (
                <>
                    <fieldset class="group-box">
                        <legend>Summary</legend>
                        <div class="group-box-content">
                            <div class="stat-row">
                                <div class="stat"><small>Today</small><b>{summary.todayVisitors}</b><small>{summary.todayLoads} page loads</small></div>
                                <div class="stat"><small>Last 7 days</small><b>{summary.weekVisitors}</b><small>{summary.weekLoads} page loads</small></div>
                                <div class="stat"><small>Since logging began</small><b>{summary.allVisitors}</b><small>{summary.allLoads} page loads</small></div>
                            </div>
                            <p class="muted" style="margin-top: 6px;">Visitors = unique IPs. Logging began {since ? fmtTime(since) : 'with the next visit'} ET. Bots and scripts are excluded.{pending > 0 && ` ${pending} IPs still waiting on a network lookup; reload to continue.`}</p>
                        </div>
                    </fieldset>

                    <fieldset class="group-box">
                        <legend>People</legend>
                        <div class="group-box-content">
                            <div class="table-wrap"><table>
                                <thead><tr><th>Who</th><th>IPs / location / network</th><th>Devices</th><th class="num">Days</th><th class="num">Loads</th><th>Last seen</th></tr></thead>
                                <tbody>
                                    {people.length === 0 && <tr><td colspan="6" class="muted">No visits logged yet.</td></tr>}
                                    {people.map(p => (
                                        <tr>
                                            <td><b>{p.name}</b>{!p.matched && <div class="muted">no chat posts from this IP</div>}</td>
                                            <td class="wrap">{[...p.ips.values()].map(i => (
                                                <div>{i.ip} <span class="muted">{[i.place, i.network, i.tags].filter(Boolean).join(' · ')}</span></div>
                                            ))}</td>
                                            <td>{[...p.devices].join(', ')}</td>
                                            <td class="num">{p.days.size}</td>
                                            <td class="num">{p.loads}</td>
                                            <td>{fmtTime(p.last)}</td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table></div>
                            <p class="muted" style="margin-top: 6px;">Names come from the most recent chat post made from each IP.</p>
                        </div>
                    </fieldset>

                    <fieldset class="group-box">
                        <legend>Daily</legend>
                        <div class="group-box-content">
                            <div class="table-wrap"><table>
                                <thead><tr><th>Day (ET)</th><th class="num">Visitors</th><th class="num">Page loads</th></tr></thead>
                                <tbody>
                                    {daily.length === 0 && <tr><td colspan="3" class="muted">No visits logged yet.</td></tr>}
                                    {daily.map(d => <tr><td>{d.day}</td><td class="num">{d.visitors}</td><td class="num">{d.loads}</td></tr>)}
                                </tbody>
                            </table></div>
                        </div>
                    </fieldset>

                    <fieldset class="group-box">
                        <legend>Recent Page Loads</legend>
                        <div class="group-box-content">
                            <div class="table-wrap"><table>
                                <thead><tr><th>Time (ET)</th><th>Who</th><th>IP</th><th>Location</th><th>Device</th><th>Page</th></tr></thead>
                                <tbody>
                                    {recent.length === 0 && <tr><td colspan="6" class="muted">No visits logged yet.</td></tr>}
                                    {recent.map(r => <tr><td>{r.time}</td><td>{r.who}</td><td>{r.ip}</td><td>{r.place}</td><td>{r.device}</td><td>{r.path}</td></tr>)}
                                </tbody>
                            </table></div>
                        </div>
                    </fieldset>

                    {bots.length > 0 && (
                        <fieldset class="group-box">
                            <legend>Bots and Scripts</legend>
                            <div class="group-box-content">
                                <div class="table-wrap"><table>
                                    <thead><tr><th>Time (ET)</th><th>IP</th><th>User agent</th></tr></thead>
                                    <tbody>{bots.map(b => <tr><td>{b.time}</td><td>{b.ip}</td><td>{b.ua}</td></tr>)}</tbody>
                                </table></div>
                            </div>
                        </fieldset>
                    )}
                </>
            )}
        </div>
        <div class="status-bar">
            <div class="status-field">{authorized ? `${people.length} people / IPs` : 'Locked'}</div>
            <div class="status-field">Times in Eastern</div>
        </div>
    </div>
</body>
</html>
