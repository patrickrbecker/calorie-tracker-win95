---
// Visitor stats (STATS_PASSWORD required): page loads logged by index.astro, names matched from chat IPs,
// network labels from Shodan (looked up once per IP and cached in ip_info)
import { createHash, timingSafeEqual } from 'node:crypto';
import { getVisits, getChatNamesByIp, getIpInfo, saveIpInfo } from '../lib/db.js';

// Auth: STATS_PASSWORD posted from the form (never in the URL); a 30-day HttpOnly cookie holds only its hash
const COOKIE = 'burnware_stats';
const password = process.env.STATS_PASSWORD || '';
const token = password ? createHash('sha256').update('burnware-stats:' + password).digest('hex') : '';
const safeEqual = (a, b) => {
  const x = Buffer.from(String(a)), y = Buffer.from(String(b));
  return x.length === y.length && timingSafeEqual(x, y);
};
let authorized = Boolean(token) && safeEqual(Astro.cookies.get(COOKIE)?.value || '', token);
let failedLogin = false;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData().catch(() => null);
  if (form?.get('action') === 'logout') {
    Astro.cookies.delete(COOKIE, { path: '/stats' });
    authorized = false;
  } else if (token && safeEqual(form?.get('password') || '', password)) {
    Astro.cookies.set(COOKIE, token, { path: '/stats', httpOnly: true, secure: true, sameSite: 'strict', maxAge: 60 * 60 * 24 * 30 });
    return Astro.redirect('/stats', 303);
  } else {
    failedLogin = true;
    await new Promise(r => setTimeout(r, 1000)); // slow down guessing
  }
}
if (!authorized) Astro.response.status = failedLogin ? 401 : 200;
Astro.response.headers.set('Cache-Control', 'no-store');

const TZ = 'America/New_York';
const BOT_RE = /bot|crawl|spider|slurp|preview|facebookexternalhit|curl|wget|python|go-http|httpclient|headless|scan/i;
const etDay = (d) => new Intl.DateTimeFormat('en-CA', { timeZone: TZ, year: 'numeric', month: '2-digit', day: '2-digit' }).format(d);
const etTime = (d) => new Intl.DateTimeFormat('en-US', { timeZone: TZ, month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }).format(d);
const dayLabel = (ymd) => new Date(ymd + 'T12:00:00Z').toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC' });

function device(ua) {
  if (!ua) return 'Unknown';
  const os = /iPhone/.test(ua) ? 'iPhone' : /iPad/.test(ua) ? 'iPad'
    : /Android/.test(ua) ? ((ua.match(/;\s*([^;)]*Pixel[^;)]*)\s*Build/) || [])[1]?.trim() || 'Android')
    : /Macintosh|Mac OS X/.test(ua) ? 'Mac' : /Windows/.test(ua) ? 'Windows' : /Linux/.test(ua) ? 'Linux' : 'Other';
  const browser = /Firefox\//.test(ua) ? 'Firefox' : /Edg\//.test(ua) ? 'Edge' : /CriOS|Chrome\//.test(ua) ? 'Chrome'
    : /Safari\//.test(ua) ? 'Safari' : '';
  return browser ? `${os} · ${browser}` : os;
}

const isLookupable = (ip) => ip && ip !== 'unknown' && !/^(127\.|10\.|192\.168\.|::1$|fe80:|172\.(1[6-9]|2\d|3[01])\.)/.test(ip);

async function shodanLookup(ip, key) {
  const ctrl = new AbortController();
  const timer = setTimeout(() => ctrl.abort(), 3000);
  const list = (a, n = 12) => (Array.isArray(a) && a.length ? a.slice(0, n).join(', ') : null);
  try {
    const res = await fetch(`https://api.shodan.io/shodan/host/${encodeURIComponent(ip)}?key=${key}&minify=true`, { signal: ctrl.signal });
    if (res.status === 404) return { ip, found: false, tags: null, domains: null, ports: null, os: null, lastScan: null, ...(await ownerLookup(ip)) };
    if (!res.ok) return null; // rate limit or outage: try again on a later load
    const d = await res.json();
    return {
      ip, found: true, org: d.org || null, isp: d.isp || null, tags: list(d.tags), asn: d.asn || null,
      hostnames: list(d.hostnames), domains: list(d.domains), ports: list([...(d.ports || [])].sort((a, b) => a - b), 30),
      os: d.os || null, city: [d.city, d.region_code].filter(Boolean).join(', ') || null,
      lastScan: d.last_update ? String(d.last_update).slice(0, 10) : null
    };
  } catch {
    return null;
  } finally {
    clearTimeout(timer);
  }
}

// Network owner for IPs Shodan has never scanned (free ipinfo.io endpoint, no key)
async function ownerLookup(ip) {
  const empty = { org: null, isp: null, asn: null, hostnames: null, city: null };
  const ctrl = new AbortController();
  const timer = setTimeout(() => ctrl.abort(), 2500);
  try {
    const res = await fetch(`https://ipinfo.io/${encodeURIComponent(ip)}/json`, { signal: ctrl.signal, headers: { accept: 'application/json' } });
    if (!res.ok) return empty;
    const d = await res.json();
    const m = /^(AS\d+)\s+(.*)$/.exec(d.org || '');
    return { org: m ? m[2] : d.org || null, isp: null, asn: m ? m[1] : null, hostnames: d.hostname || null,
      city: [d.city, d.region].filter(Boolean).join(', ') || null };
  } catch {
    return empty;
  } finally {
    clearTimeout(timer);
  }
}

// Cloud and hosting networks: visits from them are scanners, not people. Akamai, Cloudflare and Fastly are
// left out on purpose: iCloud Private Relay sends real iPhone users through them.
const CLOUD_RE = /amazon|\baws\b|google(?! fiber)|microsoft|azure|digitalocean|linode|ovh|hetzner|oracle|alibaba|tencent|vultr|choopa|contabo|scaleway|leaseweb|m247|datacamp|hostinger|ionos|upcloud|kamatera|hostwinds|psychz|quadranet|colocrossing/i;

const fmtDuration = (ms) => {
  if (!ms) return '';
  const s = Math.round(ms / 1000);
  return s < 60 ? `${s}s` : s < 3600 ? `${Math.floor(s / 60)}m ${s % 60}s` : `${Math.floor(s / 3600)}h ${Math.floor(s % 3600 / 60)}m`;
};
const refHost = (r) => {
  if (!r) return 'direct';
  try { const h = new URL(r).hostname; return /burnware\.vercel\.app$/.test(h) ? 'same site' : h; } catch { return 'other'; }
};

let error = '';
let summary = null, people = [], daily = [], recent = [], bots = [], since = null, pending = 0;

if (authorized) {
  try {
    const [visits, chatRows, infoRows] = await Promise.all([getVisits(400), getChatNamesByIp(), getIpInfo()]);
    const chatName = new Map(chatRows.map(r => [r.ip, r.username]));
    const info = new Map(infoRows.map(r => [r.ip, r]));

    const notBots = visits.filter(v => !BOT_RE.test(v.user_agent || ''));
    since = visits.length ? new Date(visits[visits.length - 1].created_at) : null;

    // Look up new IPs (and refresh pre-v3 cache rows), at most 3 per page load (Shodan allows ~1 request/second)
    const shodanKey = process.env.SHODAN_API_KEY;
    const missing = [...new Set(notBots.map(v => v.ip))].filter(ip => isLookupable(ip) && !(info.get(ip)?.schema_v >= 3));
    if (shodanKey) {
      for (const ip of missing.slice(0, 3)) {
        const r = await shodanLookup(ip, shodanKey);
        if (r) { await saveIpInfo(r).catch(() => {}); info.set(ip, { ...r, last_scan: r.lastScan, schema_v: 3 }); }
        await new Promise(res => setTimeout(res, 1100));
      }
    }
    pending = missing.filter(ip => !(info.get(ip)?.schema_v >= 3)).length;

    const cloudOwner = (ip) => {
      const i = info.get(ip);
      if (!i) return null;
      const owner = i.org || i.isp || '';
      return CLOUD_RE.test(owner) || /(^|, )cloud(,|$)/.test(i.tags || '') ? (owner || 'cloud network') : null;
    };
    const humans = notBots.filter(v => !cloudOwner(v.ip));
    bots = visits.filter(v => BOT_RE.test(v.user_agent || '') || cloudOwner(v.ip)).map(v => ({
      ...v, reason: BOT_RE.test(v.user_agent || '') ? 'bot user agent' : 'cloud network', owner: cloudOwner(v.ip) || (info.get(v.ip)?.org || '')
    }));

    // Name each visit: chat name for its IP, else the name tied to its browser ID on another visit
    const vidName = new Map();
    for (const v of humans) { const n = chatName.get(v.ip); if (n && v.visitor_id && !vidName.has(v.visitor_id)) vidName.set(v.visitor_id, n); }
    const nameOf = (v) => chatName.get(v.ip) || (v.visitor_id && vidName.get(v.visitor_id)) || null;
    const personKey = (v) => { const n = nameOf(v); return n ? 'n:' + n : v.visitor_id ? 'v:' + v.visitor_id : 'ip:' + v.ip; };

    const now = new Date();
    const today = etDay(now);
    const weekAgo = Date.now() - 7 * 864e5;
    const uniq = (rows) => new Set(rows.map(personKey)).size;
    const todayRows = humans.filter(v => etDay(new Date(v.created_at)) === today);
    const weekRows = humans.filter(v => new Date(v.created_at) >= weekAgo);
    summary = {
      todayVisitors: uniq(todayRows), todayLoads: todayRows.length,
      weekVisitors: uniq(weekRows), weekLoads: weekRows.length,
      allVisitors: uniq(humans), allLoads: humans.length
    };

    const place = (v) => [v.city, v.region].filter(Boolean).join(', ') || v.country || '';

    const groups = new Map();
    for (const v of humans) {
      const k = personKey(v);
      const name = nameOf(v);
      if (!groups.has(k)) groups.set(k, {
        name: name || 'Unknown', matched: Boolean(name), byChat: false,
        ips: new Map(), devices: new Set(), browsers: new Set(), screens: new Set(), referrers: new Set(), sections: new Set(),
        langs: new Set(), zones: new Set(), days: new Set(), loads: 0, timeMs: 0, timed: 0, scrollSum: 0, scrolled: 0, last: null
      });
      const g = groups.get(k);
      const t = new Date(v.created_at);
      if (!g.ips.has(v.ip)) {
        const i = info.get(v.ip);
        g.ips.set(v.ip, {
          ip: v.ip, place: place(v), zip: v.postal, coords: v.latitude && v.longitude ? `${v.latitude}, ${v.longitude}` : '',
          network: [i?.org || i?.isp, i?.asn].filter(Boolean).join(' '), tags: i?.tags || '',
          hostnames: i?.hostnames || '', domains: i?.domains || '', ports: i?.ports || '', os: i?.os || '',
          lastScan: i?.last_scan || '', looked: i?.schema_v >= 3, found: Boolean(i?.found)
        });
      }
      if (chatName.get(v.ip)) g.byChat = true;
      g.devices.add(device(v.user_agent));
      if (v.visitor_id) g.browsers.add(v.visitor_id);
      if (v.screen) g.screens.add(v.screen);
      g.referrers.add(refHost(v.referrer));
      (v.sections || '').split(',').filter(Boolean).forEach(s => g.sections.add(s));
      if (v.language) g.langs.add(v.language);
      if (v.timezone) g.zones.add(v.timezone);
      if (v.duration_ms) { g.timeMs += v.duration_ms; g.timed++; }
      if (v.max_scroll != null) { g.scrollSum += v.max_scroll; g.scrolled++; }
      g.days.add(etDay(t));
      g.loads++;
      if (!g.last || t > g.last) g.last = t;
    }
    people = [...groups.values()].sort((a, b) => (b.matched - a.matched) || (b.last - a.last)).map(g => ({
      ...g, ips: [...g.ips.values()],
      avgTime: g.timed ? fmtDuration(g.timeMs / g.timed) : '', totalTime: fmtDuration(g.timeMs),
      avgScroll: g.scrolled ? Math.round(g.scrollSum / g.scrolled) + '%' : ''
    }));

    const byDay = new Map();
    for (const v of humans) {
      const d = etDay(new Date(v.created_at));
      if (!byDay.has(d)) byDay.set(d, { people: new Set(), loads: 0, ms: 0 });
      const x = byDay.get(d); x.people.add(personKey(v)); x.loads++; x.ms += v.duration_ms || 0;
    }
    daily = [...byDay.entries()].sort((a, b) => b[0].localeCompare(a[0])).slice(0, 14)
      .map(([d, x]) => ({ day: dayLabel(d), visitors: x.people.size, loads: x.loads, time: fmtDuration(x.ms) }));

    recent = humans.slice(0, 40).map(v => ({
      time: etTime(new Date(v.created_at)), who: nameOf(v) || 'Unknown', ip: v.ip,
      place: [place(v), v.postal].filter(Boolean).join(' '), device: device(v.user_agent), screen: v.screen || '',
      from: refHost(v.referrer), onPage: fmtDuration(v.duration_ms), scroll: v.max_scroll != null ? v.max_scroll + '%' : '',
      sections: (v.sections || '').replace(/,/g, ', '), path: v.path
    }));
    bots = bots.slice(0, 40).map(v => ({ time: etTime(new Date(v.created_at)), ip: v.ip, owner: v.owner, reason: v.reason, place: place(v), ua: (v.user_agent || '').slice(0, 90) }));
  } catch (e) {
    console.error('Stats error:', e);
    error = 'Could not load visitor data. Check the server logs.';
  }
}
const fmtTime = (d) => d ? etTime(d) : '';
---

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Visitors - Calorie Tracker</title>
    <style>
        @font-face {
            font-family: 'W95';
            src: url('https://unpkg.com/react95@4.0.0/dist/fonts/ms_sans_serif.woff2') format('woff2');
            font-weight: 400;
        }
        @font-face {
            font-family: 'W95';
            src: url('https://unpkg.com/react95@4.0.0/dist/fonts/ms_sans_serif_bold.woff2') format('woff2');
            font-weight: 700;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --bg: #c6c6c6;
            --dark: #0a0a0a;
            --white: #fefefe;
            --gray: #848584;
            --light: #dfdfdf;
            --title-bg: #060084;
            --teal: #008080;
            --red: #a80000;
        }

        html { font-size: 14px; }

        body {
            font-family: 'W95', 'Segoe UI', Tahoma, sans-serif;
            background: url("/bg.jpg") center center / cover no-repeat fixed #008080;
            color: var(--dark);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            padding: 40px 20px;
            line-height: 1.4;
        }

        .window {
            background: var(--bg);
            border: 2px solid;
            border-color: var(--light) var(--dark) var(--dark) var(--light);
            box-shadow:
                1px 1px 0 1px var(--white) inset,
                -1px -1px 0 1px var(--gray) inset,
                rgba(0,0,0,0.35) 4px 4px 10px 0px;
            width: 100%;
            max-width: 1040px;
            position: relative;
        }

        .title-bar {
            background: var(--title-bg);
            color: var(--white);
            font-weight: 700;
            padding: 3px 4px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            user-select: none;
        }
        .title-bar span { padding-left: 2px; }
        .title-controls { display: flex; gap: 2px; }
        .title-controls button {
            width: 18px; height: 18px;
            background: var(--bg);
            border: 2px solid;
            border-color: var(--white) var(--dark) var(--dark) var(--white);
            box-shadow: 1px 1px 0 0 var(--light) inset, -1px -1px 0 0 var(--gray) inset;
            font-family: 'W95', sans-serif;
            font-size: 10px; font-weight: 700;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            padding: 0;
        }
        .title-controls button:active {
            border-color: var(--dark) var(--white) var(--white) var(--dark);
            box-shadow: 1px 1px 0 0 var(--gray) inset;
        }

        .toolbar {
            display: flex;
            align-items: center;
            padding: 4px;
            gap: 4px;
        }

        .btn {
            font-family: 'W95', sans-serif;
            font-size: 1rem;
            background: var(--bg);
            color: var(--dark);
            border: 2px solid;
            border-color: var(--white) var(--dark) var(--dark) var(--white);
            box-shadow: 1px 1px 0 0 var(--light) inset, -1px -1px 0 0 var(--gray) inset;
            padding: 3px 12px;
            height: 28px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            user-select: none;
        }
        .btn:active {
            border-color: var(--dark) var(--white) var(--white) var(--dark);
            box-shadow: 1px 1px 0 0 var(--gray) inset;
            padding-top: 5px;
        }
        .btn:disabled {
            color: var(--gray);
            text-shadow: 1px 1px 0 var(--white);
            cursor: default;
        }
        .btn.active-tab {
            background: linear-gradient(45deg, var(--bg) 25%, transparent 25%, transparent 75%, var(--bg) 75%) 0 0 / 4px 4px,
                        linear-gradient(45deg, var(--bg) 25%, transparent 25%, transparent 75%, var(--bg) 75%) 2px 2px / 4px 4px var(--white);
            border-color: var(--dark) var(--white) var(--white) var(--dark);
            box-shadow: 1px 1px 0 0 var(--gray) inset;
        }
        .btn-danger {
            background: var(--bg);
            font-weight: 700;
        }

        .content { padding: 12px; }

        .group-box {
            position: relative;
            border: 2px solid var(--white);
            padding: 12px;
            margin-bottom: 8px;
            box-shadow: var(--gray) -1px -1px 0 1px, var(--gray) -1px -1px 0 1px inset;
        }
        .group-box legend {
            position: absolute;
            top: 0; left: 8px;
            transform: translateY(calc(-50% - 2px));
            padding: 0 8px;
            background: var(--bg);
            font-weight: 700;
        }
        .group-box-content { margin-top: 6px; }

        .danger-box {
            border-color: #ff0000;
            box-shadow: #a80000 -1px -1px 0 1px, #a80000 -1px -1px 0 1px inset;
        }
        .danger-box legend { color: var(--red); }

        .info-box {
            background: #fff;
            border: 2px solid;
            border-color: var(--gray) var(--white) var(--white) var(--gray);
            box-shadow: var(--dark) 1px 1px 0 0 inset;
            padding: 8px;
            margin-bottom: 8px;
        }

        .status-msg {
            margin-top: 8px;
            padding: 8px;
            display: none;
            font-weight: 700;
        }
        .status-msg.success {
            background: #fff;
            border: 2px solid;
            border-color: var(--gray) var(--white) var(--white) var(--gray);
            color: #008000;
        }
        .status-msg.error {
            background: #fff;
            border: 2px solid;
            border-color: var(--gray) var(--white) var(--white) var(--gray);
            color: var(--red);
        }

        ul {
            list-style: none;
            padding: 0;
            margin: 8px 0;
        }
        ul li::before {
            content: '- ';
        }

        .status-bar {
            display: flex;
            border-top: 2px solid var(--gray);
            box-shadow: 0 -1px 0 0 var(--white);
        }
        .status-field {
            border: 2px solid;
            border-color: var(--gray) var(--white) var(--white) var(--gray);
            padding: 2px 6px;
            font-size: 0.85rem;
            flex: 1;
        }

        .resize-handle {
            position: absolute;
            bottom: 4px; right: 4px;
            width: 18px; height: 18px;
            background-image: linear-gradient(135deg,
                var(--white) 16.67%, var(--bg) 16.67%, var(--bg) 33.33%,
                var(--gray) 33.33%, var(--gray) 50%,
                var(--white) 50%, var(--white) 66.67%, var(--bg) 66.67%, var(--bg) 83.33%,
                var(--gray) 83.33%);
            background-size: 8.49px 8.49px;
            clip-path: polygon(100% 0, 0 100%, 100% 100%);
        }

        p + p { margin-top: 6px; }

        .stat-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
        .stat { background: #fff; border: 2px solid; border-color: var(--gray) var(--white) var(--white) var(--gray); padding: 8px; }
        .stat b { display: block; font-size: 1.6rem; line-height: 1.1; font-variant-numeric: tabular-nums; }
        .stat small { color: var(--gray); }
        .table-wrap { overflow-x: auto; background: #fff; border: 2px solid; border-color: var(--gray) var(--white) var(--white) var(--gray); }
        table { border-collapse: collapse; width: 100%; font-size: 0.9rem; }
        th, td { text-align: left; padding: 4px 8px; border-bottom: 1px solid var(--light); vertical-align: top; white-space: nowrap; }
        th { background: var(--bg); font-weight: 700; position: sticky; top: 0; }
        td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
        td.wrap { white-space: normal; min-width: 200px; }
        .muted { color: var(--gray); }
        .person { background: #fff; border: 2px solid; border-color: var(--gray) var(--white) var(--white) var(--gray); padding: 8px; display: grid; gap: 8px; min-width: 0; }
        .people { display: grid; gap: 8px; }
        .person-head { display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: baseline; }
        .person-head b { font-size: 1.15rem; }
        .person-last { margin-left: auto; }
        .facts { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 4px 12px; }
        .facts div { min-width: 0; }
        .facts .wide { grid-column: span 2; }
        fieldset.group-box { min-width: 0; }
        .facts dt { color: var(--gray); font-size: 0.8rem; }
        .facts dd { font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
        .person .table-wrap { border-color: var(--light); }
        .key-form { display: flex; gap: 8px; flex-wrap: wrap; }
        .key-form input { font-family: 'W95', sans-serif; font-size: 1rem; background: #fff; border: 2px solid; border-color: var(--gray) var(--white) var(--white) var(--gray); padding: 3px 6px; height: 28px; flex: 1; min-width: 180px; }
        @media (max-width: 600px) { .stat-row { grid-template-columns: 1fr; } body { padding: 16px; } }
    </style>
</head>
<body>
    <div class="window">
        <div class="title-bar">
            <span>Calorie Tracker - Visitors</span>
            <div class="title-controls"><button>_</button><button>&#9633;</button><button>X</button></div>
        </div>
        <div class="toolbar">
            <button class="btn" onclick="window.location.href='/'">Tracker</button>
            <button class="btn" onclick="window.location.href='/admin'">Admin</button>
            <button class="btn active-tab">Visitors</button>
            {authorized && <form method="post" action="/stats" style="margin-left: auto;"><input type="hidden" name="action" value="logout" /><button class="btn" type="submit">Log out</button></form>}
        </div>
        <div class="content">
            {!authorized ? (
                <fieldset class="group-box">
                    <legend>Password Required</legend>
                    <div class="group-box-content">
                        {failedLogin && <p style="color: var(--red); font-weight: 700;">That password is not correct.</p>}
                        <form class="key-form" method="post" action="/stats">
                            <input type="password" id="password" name="password" placeholder="Password" autocomplete="current-password" required />
                            <button class="btn" type="submit">Open</button>
                        </form>
                    </div>
                </fieldset>
            ) : error ? (
                <div class="info-box" style="color: var(--red); font-weight: 700;">{error}</div>
            ) : (
                <>
                    <fieldset class="group-box">
                        <legend>Summary</legend>
                        <div class="group-box-content">
                            <div class="stat-row">
                                <div class="stat"><small>Today</small><b>{summary.todayVisitors}</b><small>{summary.todayLoads} page loads</small></div>
                                <div class="stat"><small>Last 7 days</small><b>{summary.weekVisitors}</b><small>{summary.weekLoads} page loads</small></div>
                                <div class="stat"><small>Since logging began</small><b>{summary.allVisitors}</b><small>{summary.allLoads} page loads</small></div>
                            </div>
                            <p class="muted" style="margin-top: 6px;">Visitors = people: chat name, else browser ID, else IP. Logging began {since ? fmtTime(since) : 'with the next visit'} ET. Bots, scanners and cloud-hosted visits are excluded and listed at the bottom.{pending > 0 && ` ${pending} IPs still waiting on a network lookup; reload to continue.`}</p>
                        </div>
                    </fieldset>

                    <fieldset class="group-box">
                        <legend>People</legend>
                        <div class="group-box-content people">
                            {people.length === 0 && <div class="info-box muted">No visits logged yet.</div>}
                            {people.map(p => (
                                <div class="person">
                                    <div class="person-head">
                                        <b>{p.name}</b>
                                        <span class="muted">{!p.matched ? 'no chat posts from this IP or browser' : p.byChat ? 'matched by chat IP' : 'matched by browser ID'}</span>
                                        <span class="person-last">Last seen {fmtTime(p.last)}</span>
                                    </div>
                                    <dl class="facts">
                                        <div><dt>Days</dt><dd>{p.days.size}</dd></div>
                                        <div><dt>Page loads</dt><dd>{p.loads}</dd></div>
                                        <div><dt>Avg time on page</dt><dd>{p.avgTime || '-'}</dd></div>
                                        <div><dt>Total time</dt><dd>{p.totalTime || '-'}</dd></div>
                                        <div><dt>Avg scroll</dt><dd>{p.avgScroll || '-'}</dd></div>
                                        <div><dt>Browsers</dt><dd>{p.browsers.size || '-'}</dd></div>
                                        <div class="wide"><dt>Devices</dt><dd>{[...p.devices].join(', ')}</dd></div>
                                        <div class="wide"><dt>Screens</dt><dd>{[...p.screens].join(', ') || '-'}</dd></div>
                                        <div class="wide"><dt>Sections seen</dt><dd>{[...p.sections].join(', ') || '-'}</dd></div>
                                        <div class="wide"><dt>Came from</dt><dd>{[...p.referrers].join(', ')}</dd></div>
                                        <div class="wide"><dt>Language / timezone</dt><dd>{[[...p.langs].join(', '), [...p.zones].join(', ')].filter(Boolean).join(' · ') || '-'}</dd></div>
                                    </dl>
                                    <div class="table-wrap"><table>
                                        <thead><tr><th>IP</th><th>Location (Vercel)</th><th>ZIP</th><th>Coordinates</th><th>Network / ASN</th><th>Labels</th><th>Hostnames / domains</th><th>Open ports</th><th>OS</th><th>Shodan scan</th></tr></thead>
                                        <tbody>
                                            {p.ips.map(i => (
                                                <tr>
                                                    <td>{i.ip}</td><td>{i.place}</td><td>{i.zip}</td><td>{i.coords}</td>
                                                    <td>{i.network}{i.looked && !i.found && <span class="muted">{i.network ? ' (no Shodan record)' : 'no Shodan record'}</span>}{!i.looked && <span class="muted">pending</span>}</td>
                                                    <td>{i.tags}</td>
                                                    <td class="wrap">{[i.hostnames, i.domains].filter(Boolean).join(' · ')}</td>
                                                    <td class="wrap">{i.ports}</td><td>{i.os}</td><td>{i.lastScan}</td>
                                                </tr>
                                            ))}
                                        </tbody>
                                    </table></div>
                                </div>
                            ))}
                            <p class="muted">Names come from the most recent chat post made from each IP, carried over to other IPs that share the same browser ID.</p>
                        </div>
                    </fieldset>

                    <fieldset class="group-box">
                        <legend>Daily</legend>
                        <div class="group-box-content">
                            <div class="table-wrap"><table>
                                <thead><tr><th>Day (ET)</th><th class="num">Visitors</th><th class="num">Page loads</th><th class="num">Time on site</th></tr></thead>
                                <tbody>
                                    {daily.length === 0 && <tr><td colspan="4" class="muted">No visits logged yet.</td></tr>}
                                    {daily.map(d => <tr><td>{d.day}</td><td class="num">{d.visitors}</td><td class="num">{d.loads}</td><td class="num">{d.time}</td></tr>)}
                                </tbody>
                            </table></div>
                        </div>
                    </fieldset>

                    <fieldset class="group-box">
                        <legend>Recent Page Loads</legend>
                        <div class="group-box-content">
                            <div class="table-wrap"><table>
                                <thead><tr><th>Time (ET)</th><th>Who</th><th>IP</th><th>Location</th><th>Device</th><th>Screen</th><th>Came from</th><th class="num">On page</th><th class="num">Scroll</th><th>Sections</th><th>Page</th></tr></thead>
                                <tbody>
                                    {recent.length === 0 && <tr><td colspan="11" class="muted">No visits logged yet.</td></tr>}
                                    {recent.map(r => <tr><td>{r.time}</td><td>{r.who}</td><td>{r.ip}</td><td>{r.place}</td><td>{r.device}</td><td>{r.screen}</td><td>{r.from}</td><td class="num">{r.onPage}</td><td class="num">{r.scroll}</td><td>{r.sections}</td><td>{r.path}</td></tr>)}
                                </tbody>
                            </table></div>
                            <p class="muted" style="margin-top: 6px;">Time on page counts only while the tab is visible. It fills in when the visitor leaves or switches tabs.</p>
                        </div>
                    </fieldset>

                    {bots.length > 0 && (
                        <fieldset class="group-box">
                            <legend>Bots, Scanners and Cloud</legend>
                            <div class="group-box-content">
                                <div class="table-wrap"><table>
                                    <thead><tr><th>Time (ET)</th><th>IP</th><th>Network</th><th>Location</th><th>Why</th><th>User agent</th></tr></thead>
                                    <tbody>{bots.map(b => <tr><td>{b.time}</td><td>{b.ip}</td><td>{b.owner}</td><td>{b.place}</td><td>{b.reason}</td><td>{b.ua}</td></tr>)}</tbody>
                                </table></div>
                            </div>
                        </fieldset>
                    )}
                </>
            )}
        </div>
        <div class="status-bar">
            <div class="status-field">{authorized ? `${people.length} people / IPs` : 'Locked'}</div>
            <div class="status-field">Times in Eastern</div>
        </div>
    </div>
</body>
</html>
